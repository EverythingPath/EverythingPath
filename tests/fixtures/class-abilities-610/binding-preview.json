  "closure": [
    {
      "externalKey": "pf1/26k1Gi7t5BoqxhIj",
      "upstreamKey": "pf1/26k1Gi7t5BoqxhIj",
      "pack": "feats",
      "name": "Vital Strike",
      "detail": {
        "kind": "feat",
        "featTypes": ["Combat", "Offensive"],
        "repeatable": "unreviewed"
      },
      "description": "<i>You make a single attack that deals significantly more damage than normal.</i><p><strong>Prerequisites</strong>: Base attack bonus +6.</p><p><strong>Benefits</strong>: When you use the attack action, you can make one attack at your highest base attack bonus that deals additional damage. Roll the weapon's damage dice for the attack twice and add the results together before adding bonuses from Strength, weapon abilities (such as <i>flaming</i>), precision based damage, and other damage bonuses. These extra weapon damage dice are not multiplied on a critical hit, but are added to the total.</p>",
      "prerequisiteText": "Base attack bonus +6",
      "prerequisites": [
        {
          "bab": 6,
          "kind": "bab"
        }
      ],
      "sources": [
        {
          "book": "PZO1110",
          "pages": "117, 136"
        }
      ],
      "modifiers": [],
      "unsupported": [],
      "situationalNotes": [
        {
          "text": "On the attack action, make one attack at your highest base attack bonus and roll the weapon’s damage dice twice before adding other damage bonuses. Extra weapon dice are not multiplied on a critical hit."
        }
      ]
    },
    {
      "externalKey": "pf1/8rsFtye3PwM6CKli",
      "upstreamKey": "pf1/8rsFtye3PwM6CKli",
      "pack": "feats",
      "name": "Point-Blank Shot",
      "detail": {
        "kind": "feat",
        "featTypes": ["Combat"],
        "repeatable": "unreviewed"
      },
      "description": "<p><em>You are especially accurate when making ranged attacks against close targets.</em></p><p><strong>Benefits</strong>: You get a +1 bonus on attack and damage rolls with ranged weapons at ranges of up to 30 feet.</p><p><b>Combat Trick</b><br>You can spend up to 6 stamina points to increase this feat's range by 5 feet for each stamina point you spent.</p>",
      "sources": [
        {
          "book": "PZO1110",
          "pages": "116, 131"
        }
      ],
      "modifiers": [
        {
          "target": "attack.ranged",
          "bonusType": "untyped",
          "value": 1,
          "condition": {
            "situation": "within30ft"
          }
        },
        {
          "target": "damage.ranged",
          "bonusType": "untyped",
          "value": 1,
          "condition": {
            "situation": "within30ft"
          }
        }
      ],
      "unsupported": []
    },
    {
      "externalKey": "pf1/n250dFlbykAIAg5Z",
      "upstreamKey": "pf1/n250dFlbykAIAg5Z",
      "pack": "feats",
      "name": "Weapon Focus",
      "detail": {
        "kind": "feat",
        "featTypes": ["Combat", "Weapon", "Offensive"],
        "repeatable": "unreviewed"
      },
      "description": "<i>Choose one type of weapon. You can also choose unarmed strike or grapple (or ray, if you are a spellcaster) as your weapon for the purposes of this feat.</i><p><strong>Prerequisites</strong>: Proficiency with selected weapon, base attack bonus +1.</p><p><strong>Benefits</strong>: You gain a +1 bonus on all attack rolls you make using the selected weapon.</p><p><strong>Special</strong>: You can gain this feat multiple times. Its effects do not stack. Each time you take the feat, it applies to a new type of weapon.</p>",
      "prerequisiteText": "Proficiency with selected weapon, base attack bonus +1",
      "prerequisites": [
        {
          "unchecked": "Proficiency with selected weapon, base attack bonus +1",
          "kind": "unchecked"
        }
      ],
      "sources": [
